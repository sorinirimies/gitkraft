#!/usr/bin/env nu
# ── GitKraft · rpm_spec.nu ──────────────────────────────────────────
# One RPM spec for Fedora (COPR) and openSUSE (OBS): built from the release's
# source tarball plus a vendored-crates tarball, so it compiles offline (OBS has
# no network). Every binary in scripts/project.nu is a (sub)package, with the
# same files as its .deb.
#
# Usage:
#   nu scripts/ci/rpm_spec.nu sources <version> --out <dir>   # spec + both tarballs
#   nu scripts/ci/rpm_spec.nu spec <version>                  # the spec on stdout

use ../project.nu [APP BINS]
use package_desktop.nu [package-files plain-version deb-name tarball-url]

# Compiling the GUI: the display headers, plus perl for vendored OpenSSL. Written as
# pkgconfig()/perl() so the same names resolve on Fedora and openSUSE.
export const RPM_BUILD_REQUIRES = [
    "cargo >= 1.91" "rust >= 1.91" gcc make
    "perl(FindBin)" "perl(IPC::Cmd)" "perl(File::Compare)" "perl(File::Copy)" "perl(Time::Piece)"
    "pkgconfig(fontconfig)" "pkgconfig(gl)" "pkgconfig(wayland-client)" "pkgconfig(x11)" "pkgconfig(xcursor)"
    "pkgconfig(xi)" "pkgconfig(xinerama)" "pkgconfig(xkbcommon)" "pkgconfig(xrandr)" "pkgconfig(zlib)"
]

# The vendored crates tarball of a version.
export def vendor-name [app: record, version: string]: nothing -> string {
    $"($app.id)-(plain-version $version)-vendor.tar.xz"
}

# rpm expands % everywhere, also inside a here-document (`Exec=app %U`).
export def rpm-escape [text: string]: nothing -> string { $text | str replace --all '%' '%%' }

# The package a binary ships in: the app's own name for its main binary,
# otherwise the binary's (Debian-style) name.
export def rpm-package [app: record, bin: record]: nothing -> string { deb-name $bin.bin }

# The %install lines and %files entries of one binary.
export def rpm-parts [app: record, bin: record, existing: list<string>]: nothing -> record<install: list<string>, files: list<string>> {
    let files = package-files $app $bin "" $existing
    let install = $files | each {|f|
        if ($f.src? | is-not-empty) {
            let src = $f.src | str replace 'target//release/' 'target/release/'
            let mode = if ($f.dst | str starts-with "usr/bin/") { "0755" } else { "0644" }
            $"install -Dpm($mode) ($src) %{buildroot}/($f.dst)"
        } else {
            $"install -Dpm0644 /dev/stdin %{buildroot}/($f.dst) <<'EOF'\n(rpm-escape ($f.text | str trim))\nEOF"
        }
    }
    {install: $install, files: ($files | each {|f| $"/($f.dst)" })}
}

# The whole spec.
export def rpm-spec [app: record, bins: list<record>, version: string, existing: list<string>]: nothing -> string {
    let v = plain-version $version
    let main = $bins | where {|b| (rpm-package $app $b) == $app.id } | get -o 0 | default ($bins | first)
    let subs = $bins | where bin != $main.bin
    let parts = $bins | each {|b| {bin: $b, parts: (rpm-parts $app $b $existing)} }
    let crates = $bins | get crate | uniq | each {|c| $"-p ($c)" } | str join " "
    let requires = $RPM_BUILD_REQUIRES | each {|r| $"BuildRequires:  ($r)" } | str join "\n"
    let sub_headers = $subs | each {|b|
        $"%package -n (rpm-package $app $b)\nSummary:        ($b.summary)\n\n%description -n (rpm-package $app $b)\n($b.summary). ($app.summary)."
    } | str join "\n\n"
    let install = $parts | each {|p| $p.parts.install } | flatten | str join "\n"
    let files = $parts | each {|p|
        let head = if $p.bin.bin == $main.bin { "%files" } else { $"%files -n (rpm-package $app $p.bin)" }
        [$head "%license LICENSE" ...$p.parts.files] | str join "\n"
    } | str join "\n\n"
    $"# Generated by scripts/ci/rpm_spec.nu: do not edit.
# Rust binaries carry no separate debug info.
%global debug_package %{nil}

Name:           ($app.id)
Version:        ($v)
Release:        1%{?dist}
Summary:        ($main.summary)
License:        ($app.license)
URL:            ($app.homepage)
Source0:        (tarball-url $app $v | str replace $v '%{version}')#/%{name}-%{version}.tar.gz
# `cargo vendor` of the same tag \(scripts/ci/rpm_spec.nu sources).
Source1:        %{name}-%{version}-vendor.tar.xz

($requires)

%description
($app.summary).

($sub_headers)

%prep
%autosetup -n %{name}-%{version}
tar -xJf %{SOURCE1}
mkdir -p .cargo
cat >> .cargo/config.toml <<'EOF'

[source.crates-io]
replace-with = \"vendored-sources\"

[source.vendored-sources]
directory = \"vendor\"
EOF

%build
cargo build --release --frozen ($crates)

%install
($install)

($files)
"
}

def existing-files []: nothing -> list<string> {
    glob assets/icons/* | each {|p| $p | path relative-to $env.PWD }
}

def "main spec" [version: string] { print -n (rpm-spec $APP $BINS $version (existing-files)) }

# Writes <out>/<id>.spec, <out>/<id>-<v>.tar.gz (the GitHub tag tarball) and
# <out>/<id>-<v>-vendor.tar.xz (`cargo vendor` of the tag's Cargo.lock).
def "main sources" [version: string, --out: string] {
    let v = plain-version $version
    mkdir $out
    let out = $out | path expand
    rpm-spec $APP $BINS $v (existing-files) | save --force $"($out)/($APP.id).spec"
    http get --raw (tarball-url $APP $v) | save --force $"($out)/($APP.id)-($v).tar.gz"
    let tmp = mktemp -d
    ^tar -xzf $"($out)/($APP.id)-($v).tar.gz" -C $tmp
    do {
        cd $"($tmp)/($APP.id)-($v)"
        ^cargo vendor --locked --versioned-dirs vendor | ignore
        ^tar -cJf $"($out)/(vendor-name $APP $v)" vendor
    }
    rm -rf $tmp
    print -e $"✅ ($out): spec, source and vendor tarballs for ($v)"
}

# The package manager command that installs `packages` on this distro.
export def install-command [os_id: string, packages: list<string>]: nothing -> list<string> {
    if ($os_id | str starts-with "opensuse") or $os_id == "sles" {
        # --force-resolution: the container image's busybox stand-ins (busybox-gawk…)
        # give way to the real tools rpm-build needs.
        [zypper --non-interactive install --no-recommends --force-resolution ...$packages]
    } else {
        [dnf install -y --setopt=install_weak_deps=False ...$packages]
    }
}

def os-id []: nothing -> string {
    open /etc/os-release | lines | parse "{k}={v}" | where k == ID | get v.0 | str trim --char '"'
}

def run-cmd [cmd: list<string>] { run-external $cmd.0 ...($cmd | skip 1) }

# In a Fedora or openSUSE container (as root): installs the build dependencies,
# builds the source and binary rpms from <dir> (spec + tarballs), installs the
# binary rpms and checks that every binary loads. The rpms land in <dir>/out.
def "main build" [dir: string] {
    let dir = $dir | path expand
    let os = os-id
    run-cmd (install-command $os [rpm-build])
    let spec = $"($dir)/($APP.id).spec"
    let deps = ^rpmspec -q --buildrequires $spec | lines | where {|l| $l | str trim | is-not-empty }
    run-cmd (install-command $os $deps)
    ^rpmbuild -ba $spec --define $"_sourcedir ($dir)" --define $"_rpmdir ($dir)/out" --define $"_srcrpmdir ($dir)/out"
    let rpms = glob $"($dir)/out/**/*.rpm" | where {|f| not ($f | str ends-with ".src.rpm") }
    run-cmd (install-command $os $rpms)
    for b in $BINS {
        let ldd = ^ldd $"/usr/bin/($b.bin)" | complete
        if ($ldd.stdout | str contains "not found") { error make {msg: $"($b.bin): ($ldd.stdout)"} }
        if $b.kind != "gui" {
            let r = do { ^$"/usr/bin/($b.bin)" --version } | complete
            if $r.exit_code >= 126 { error make {msg: $"($b.bin) does not start: ($r.stderr)"} }
        }
    }
    print -e $"✅ ($os): built and installed ($rpms | length) rpms; every binary loads"
}

# The copr-cli configuration from the API token COPR shows at
# https://copr.fedorainfracloud.org/api/ (login, username, token).
export def copr-config [login: string, username: string, token: string]: nothing -> string {
    $"[copr-cli]\nlogin = ($login)\nusername = ($username)\ntoken = ($token)\ncopr_url = https://copr.fedorainfracloud.org\n"
}

# The chroots the COPR project builds for.
export const COPR_CHROOTS = ["fedora-rawhide-x86_64" "fedora-rawhide-aarch64" "fedora-43-x86_64" "fedora-43-aarch64" "fedora-42-x86_64" "fedora-42-aarch64"]

# Sends the source rpm in <dir> to the COPR project <owner>/<id> (created on
# first use). Needs $COPR_LOGIN, $COPR_USERNAME, $COPR_TOKEN; without them it
# does nothing.
def "main copr" [dir: string] {
    let login = $env.COPR_LOGIN? | default ""
    if ($login | is-empty) { print "copr=skipped"; return }
    let srpm = glob $"($dir)/*.src.rpm" | first
    let conf = mktemp
    copr-config $login $env.COPR_USERNAME $env.COPR_TOKEN | save --force $conf
    let project = $"($env.COPR_USERNAME)/($APP.id)"
    let chroots = $COPR_CHROOTS | each {|c| [--chroot $c] } | flatten
    let created = do { ^copr-cli --config $conf create $APP.id ...$chroots --enable-net off --description $APP.summary } | complete
    if $created.exit_code == 0 { print -e $"created COPR project ($project)" }
    ^copr-cli --config $conf build $project $srpm
    rm $conf
    print $"copr=($project)"
}

# The OBS repositories: Tumbleweed (x86-64 from Factory, arm64 from its ARM port)
# and Leap 16.0.
export const OBS_REPOS = [
    [name project repository archs];
    [openSUSE_Tumbleweed "openSUSE:Factory" snapshot [x86_64]]
    [openSUSE_Factory_ARM "openSUSE:Factory:ARM" standard [aarch64]]
    ["openSUSE_Leap_16.0" "openSUSE:Leap:16.0" standard [x86_64 aarch64]]
]

# The OBS project, home:<user>:<id>.
export def obs-project [user: string, app: record]: nothing -> string { $"home:($user):($app.id)" }

def xml-escape [s: string]: nothing -> string {
    $s | str replace --all '&' '&amp;' | str replace --all '<' '&lt;' | str replace --all '>' '&gt;' | str replace --all '"' '&quot;'
}

# The project's _meta: title, maintainer and repositories.
export def obs-project-meta [user: string, app: record]: nothing -> string {
    let repos = $OBS_REPOS | each {|r|
        let archs = $r.archs | each {|a| $"    <arch>($a)</arch>" } | str join "\n"
        $"  <repository name=\"($r.name)\">\n    <path project=\"($r.project)\" repository=\"($r.repository)\"/>\n($archs)\n  </repository>"
    } | str join "\n"
    $"<project name=\"(obs-project $user $app)\">
  <title>($app.title)</title>
  <description>(xml-escape $app.summary) \(($app.homepage))</description>
  <person userid=\"($user)\" role=\"maintainer\"/>
($repos)
</project>
"
}

# The package's _meta.
export def obs-package-meta [user: string, app: record]: nothing -> string {
    $"<package name=\"($app.id)\" project=\"(obs-project $user $app)\">
  <title>($app.title)</title>
  <description>(xml-escape $app.summary)</description>
  <url>($app.homepage)</url>
</package>
"
}

# The zypper line users add the repository with.
export def obs-repo-url [user: string, app: record, repo: string]: nothing -> string {
    let p = obs-project $user $app
    $"https://download.opensuse.org/repositories/($p | str replace --all ':' ':/')/($repo)/($p).repo"
}

# Commits the spec and tarballs in <dir> to OBS (project and package are created
# or updated first); OBS then builds them for OBS_REPOS. Needs $OBS_USER and
# $OBS_PASSWORD; without them it does nothing.
def "main obs" [dir: string, version: string] {
    let user = $env.OBS_USER? | default ""
    if ($user | is-empty) { print "obs=skipped"; return }
    let dir = $dir | path expand
    let project = obs-project $user $APP
    let home = mktemp -d
    let rc = $"($home)/oscrc"
    $"[general]\napiurl = https://api.opensuse.org\n[https://api.opensuse.org]\nuser = ($user)\npass = ($env.OBS_PASSWORD)\ncredentials_mgr_class = osc.credentials.PlaintextConfigFileCredentialsManager\n" | save $rc
    let osc = [osc --config $rc]
    obs-project-meta $user $APP | save $"($home)/prj.xml"
    obs-package-meta $user $APP | save $"($home)/pkg.xml"
    run-cmd [...$osc meta prj $project --file $"($home)/prj.xml"]
    run-cmd [...$osc meta pkg $project $APP.id --file $"($home)/pkg.xml"]
    do {
        cd $home
        run-cmd [...$osc checkout $project $APP.id]
        let pkg = $"($home)/($project)/($APP.id)"
        glob $"($pkg)/*" | each {|f| rm $f } | ignore
        for f in (glob $"($dir)/*" | where {|f| ($f | path type) == file }) { cp $f $pkg }
        cd $pkg
        run-cmd [...$osc addremove]
        run-cmd [...$osc commit -m $"Update to (plain-version $version)"]
    }
    rm -rf $home
    print $"obs=($project)"
}

def main [] { print "usage: rpm_spec.nu spec <version> | sources <version> --out <dir> | build <dir> | copr <dir> | obs <dir> <version>" }
